{
	"name": "@sortea/web",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "node --env-file-if-exists=../../.env node_modules/vite/bin/vite.js dev --host 0.0.0.0",
		"build": "node --env-file-if-exists=../../.env node_modules/vite/bin/vite.js build",
		"preview": "node --env-file-if-exists=../../.env node_modules/vite/bin/vite.js preview",
		"start": "node build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:e2e": "playwright test"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource-variable/archivo": "^5.3.0",
		"@fontsource-variable/big-shoulders-display": "^5.3.0",
		"@fontsource-variable/inter-tight": "^5.3.0",
		"@sortea/domain": "workspace:*",
		"gsap": "^3.15.0",
		"lenis": "^1.3.26",
		"marked": "^18.1.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^22.19.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vitest": "^4.1.8"
	}
}
