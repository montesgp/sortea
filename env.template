# Template for the local .env file. Generate it with `pnpm setup:env`
# (local Supabase must be running). Never commit real values.
# Production values live in Railway variables.

# ─── Database and Supabase ─────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
# Browser-safe key, used only for admin sign-in.
SUPABASE_PUBLISHABLE_KEY=
# Server-only key: storage signed URLs and auth admin. Never sent to the browser.
SUPABASE_SECRET_KEY=
STORAGE_BUCKET=product-assets
# Public bucket for site images uploaded from the CMS (JPEG, PNG, WebP up to 2 MB).
MEDIA_BUCKET=site-media

# ─── Secrets owned by the API ─────────────────────────────────────────────
# AES-256-GCM key ring for tenant integration secrets: v1:<base64 32 bytes>[,v2:...]
SECRETS_KEY_RING=
# HMAC peppers for lookup codes and public pseudonyms.
LOOKUP_PEPPER=
PSEUDONYM_PEPPER=
# Shared secret between the web BFF and the API (the API is private except /webhooks).
INTERNAL_API_TOKEN=

# ─── Services ─────────────────────────────────────────────────────────────
API_PORT=3001
API_INTERNAL_URL=http://127.0.0.1:3001
# Public base URL of the API, used for Mercado Pago notification_url (needs a tunnel locally).
API_PUBLIC_URL=http://localhost:3001
# Origin used in links when a tenant has no primary domain configured (local development).
WEB_FALLBACK_ORIGIN=http://localhost:5173

# ─── Payments ─────────────────────────────────────────────────────────────
# Local simulator that drives the real webhook path. Refused when NODE_ENV=production.
PAYMENTS_FAKE_PROVIDER=true
DEV_WEBHOOK_SECRET=
# Minutes between scheduled reconciliations per organization. The worker asks
# the API (API_INTERNAL_URL + INTERNAL_API_TOKEN) to run the ones that are due.
RECONCILE_INTERVAL_MINUTES=30

# ─── Email ────────────────────────────────────────────────────────────────
# smtp (local Mailpit at http://127.0.0.1:54324) | resend | log
EMAIL_PROVIDER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
RESEND_API_KEY=
EMAIL_FROM_DOMAIN=sortea.local

# ─── Local accounts ───────────────────────────────────────────────────────
# Password of the seeded admin accounts; also used by the E2E tests
# (scripts/dev/run-all.bat test). Local development only.
SEED_ADMIN_PASSWORD=

# ─── Security ─────────────────────────────────────────────────────────────
# Require an MFA (aal2) session for admin access. Must be true in production.
REQUIRE_ADMIN_MFA=false
