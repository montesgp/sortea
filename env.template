# Template for the local .env file. Generate it with `pnpm setup:env`; its defaults are
# the local stack of docker-compose.yml (`pnpm db:start`). Never commit real values.
# Production values live in Railway variables.

# ─── Database ─────────────────────────────────────────────────────────────
# Locally: the compose Postgres (user, password and database `postgres`) on 127.0.0.1:54322.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ─── Files (S3-compatible bucket, ADR 0020) ───────────────────────────────
# One private bucket per environment: product-assets/ (paid downloads) and site-media/
# (CMS images and videos). Read by the API and the operator commands only, never by the web.
# Locally: MinIO from docker-compose.yml (`pnpm db:start`, then `pnpm storage:init`); the
# compose file reads the same key and secret. On Railway each value comes from the bucket's
# credentials (README, "Deploy"). Leave S3_ENDPOINT empty only for AWS S3 itself.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=sortea-local
S3_ACCESS_KEY_ID=sortea-local
S3_SECRET_ACCESS_KEY=sortea-local-secret
# true: https://endpoint/bucket/key (MinIO); false: https://bucket.endpoint/key.
S3_FORCE_PATH_STYLE=true
# Web and worker: origin of the bucket's presigned URLs, the one place downloads and /media/<key> may
# redirect to; also read when the web is built, for the CSP img-src and media-src (ADR 0009). The worker
# follows the /media redirect for the ticket logo only to it (optional there, ADR 0023).
# Path style: the S3_ENDPOINT origin; virtual-hosted style: https://<S3_BUCKET>.<endpoint host>.
# The API logs the value it signs for when it starts.
MEDIA_PUBLIC_ORIGIN=http://127.0.0.1:9000

# ─── Secrets owned by the API ─────────────────────────────────────────────
# AES-256-GCM key ring for tenant integration secrets: v1:<base64 32 bytes>[,v2:...]
SECRETS_KEY_RING=
# HMAC peppers for lookup codes and public pseudonyms.
LOOKUP_PEPPER=
PSEUDONYM_PEPPER=
# Shared secret between the web BFF and the API (the API is private except /webhooks).
INTERNAL_API_TOKEN=

# ─── Services ─────────────────────────────────────────────────────────────
# The API listens on API_PORT, else on PORT (what Railway injects). It binds :: (IPv6 and IPv4,
# for Railway's private network) and falls back to 0.0.0.0; API_HOST names one address instead.
API_PORT=3001
API_INTERNAL_URL=http://127.0.0.1:3001
# Public base URL of the API, used for Mercado Pago notification_url (needs a tunnel locally).
API_PUBLIC_URL=http://localhost:3001
# Origin used in links when a tenant has no primary domain configured (local development).
WEB_FALLBACK_ORIGIN=http://localhost:5173
# Web (adapter-node) request body limit for the whole server. Only the video upload uses
# it; a guard keeps every other route at 3 MB (ADR 0009). Production: 52M. The dev server ignores it.
BODY_SIZE_LIMIT=52M

# ─── Payments ─────────────────────────────────────────────────────────────
# Local simulator that drives the real webhook path. Refused when NODE_ENV=production.
PAYMENTS_FAKE_PROVIDER=true
DEV_WEBHOOK_SECRET=
# Minutes between scheduled reconciliations per organization. The worker asks
# the API (API_INTERNAL_URL + INTERNAL_API_TOKEN) to run the ones that are due.
RECONCILE_INTERVAL_MINUTES=30

# ─── Email ────────────────────────────────────────────────────────────────
# smtp (Mailpit from docker-compose.yml: web at http://127.0.0.1:54324, SMTP on 54325) | resend | log
EMAIL_PROVIDER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
# Production: EMAIL_PROVIDER=resend, a sending-only key and a domain verified in Resend (README, Email).
RESEND_API_KEY=
EMAIL_FROM_DOMAIN=sortea.local

# ─── Backups (ADR 0020, README "Backups") ─────────────────────────────────
# Names the bucket prefix backups/<DEPLOY_ENVIRONMENT>/ and, with production, guards
# `pnpm db:restore` against the environment's own database. Deployed: production or staging.
DEPLOY_ENVIRONMENT=development
# Worker: nightly pg_dump into the bucket from BACKUP_HOUR_UTC on (default 6 = 03:00 in Argentina).
# Needs the S3_* variables on the worker. Production projects only (README, "Deploy").
# Only true or false (or empty): any other value stops the worker, so a typo never turns backups off silently.
BACKUP_ENABLED=false
BACKUP_HOUR_UTC=6
# The API's pre-deploy dumps the database before pending migrations; false skips it.
# PREMIGRATE_BACKUP=true
# Directory of pg_dump, pg_restore and psql 17 when they are not on PATH (the images set it).
# PG_BIN_DIR=

# ─── Local accounts ───────────────────────────────────────────────────────
# Password of the seeded admin accounts; also used by the E2E tests (scripts/dev/run-all.bat test).
# Local development only. Deployed environments create accounts with `pnpm admin:user`.
SEED_ADMIN_PASSWORD=

# ─── Security ─────────────────────────────────────────────────────────────
# Require a session confirmed with the authenticator app (TOTP) for admin access. Must be true in production.
REQUIRE_ADMIN_MFA=false
